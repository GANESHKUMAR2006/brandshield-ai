# BrandShield AI — Environment Configuration Example
# Duplicate this file as .env.local for local development.
# IMPORTANT: Never commit actual keys, tokens, or credentials to version control.

# Application Settings
NEXT_PUBLIC_APP_NAME="BrandShield AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_DEFAULT_WORKSPACE="DermaGlow"

# Supabase Project Configuration (Phase 2+)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_placeholder"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-placeholder"

# Server-Side Database Connection (Server-only credentials)
SUPABASE_DB_HOST="db.your-project-ref.supabase.co"
SUPABASE_DB_PORT="5432"
SUPABASE_DB_USER="postgres"
SUPABASE_DB_NAME="postgres"
SUPABASE_DB_PASSWORD="your-secure-database-password"
SUPABASE_DATABASE_URL="postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres"

# Optional Service Role Key (Server-only for privileged background workers)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-placeholder"

# LLM Provider Configuration (Phase 4 Extraction Engine)
# Options: "ollama" | "huggingface" | "openai" | "mock" (mock is strictly for automated test suites)
LLM_PROVIDER="ollama"

# Ollama Configuration (Local Offline Development)
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="qwen3:4b"
EMBEDDING_PROVIDER="mock"

# Hugging Face Router Configuration (OpenAI-compatible)
HF_TOKEN="hf_your_token_placeholder"
HF_BASE_URL="https://router.huggingface.co/v1"
HF_MODEL="Qwen/Qwen3-32B"

# OpenAI Provider Configuration (Cloud Production)
OPENAI_API_KEY="sk-placeholder-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY="sk-ant-placeholder-anthropic-key"
DEFAULT_LLM_MODEL="gpt-4o"
EMBEDDING_MODEL="text-embedding-3-small"
