# ==============================================================================
# BrandShield AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# 1. Never commit .env.local or any real secrets to version control.
# 2. Variables prefixed with NEXT_PUBLIC_ are bundled into client-side JavaScript.
# 3. Secret keys (GROQ_API_KEY, SUPABASE_DATABASE_URL, SMTP_PASS, etc.) are strictly
#    server-only and must NEVER use the NEXT_PUBLIC_ prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core Settings (Publicly Accessible)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="BrandShield AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_DEFAULT_WORKSPACE="DermaGlow"

# ------------------------------------------------------------------------------
# 2. Supabase Client Configuration (Public / Browser Safe)
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_placeholder"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder"

# ------------------------------------------------------------------------------
# 3. Server-Side PostgreSQL Database Connection (SERVER ONLY - STRICTLY PRIVATE)
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or direct: postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_DATABASE_URL="postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres"

# Optional: Individual connection parameters (alternative to SUPABASE_DATABASE_URL)
# SUPABASE_DB_HOST="db.your-project-ref.supabase.co"
# SUPABASE_DB_PORT="5432"
# SUPABASE_DB_USER="postgres"
# SUPABASE_DB_NAME="postgres"
# SUPABASE_DB_PASSWORD="your-secure-database-password"

# Optional Privileged Key (SERVER ONLY - for background administrative jobs)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-placeholder"

# ------------------------------------------------------------------------------
# 4. Authentication & Showcase Persona Settings
# ------------------------------------------------------------------------------
# Set to "true" to allow demo reviewer quick-login personas on staging/dev environments.
# Set to "false" in strict enterprise production deployments.
ALLOW_DEMO_AUTH="true"

# ------------------------------------------------------------------------------
# 5. LLM Claim Extraction Provider (SERVER ONLY)
# ------------------------------------------------------------------------------
# Active extraction provider: "groq" (Recommended / Default) | "openai" | "ollama" | "huggingface" | "mock"
LLM_PROVIDER="groq"

# --- Groq Cloud Inference (Default & Recommended) ---
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_placeholder"
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# --- Local Ollama Inference (Alternative for offline / air-gapped dev) ---
# Run: ollama pull qwen3:4b
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="qwen3:4b"

# --- OpenAI Provider (Alternative Cloud Provider) ---
# OPENAI_API_KEY="sk-your-openai-api-key-placeholder"
# OPENAI_MODEL="gpt-4o"

# --- Hugging Face Provider (Alternative Router) ---
# HF_TOKEN="hf_your_token_placeholder"
# HF_MODEL="Qwen/Qwen2.5-7B-Instruct"
# HF_BASE_URL="https://router.huggingface.co/novita/v1"

# ------------------------------------------------------------------------------
# 6. RAG Vector Embedding Provider (SERVER ONLY)
# ------------------------------------------------------------------------------
# Active embedding provider: "openai" (Production) | "mock" (Local/Offline Testing)
# When set to "mock", a deterministic 1536-dimension vector is generated locally.
EMBEDDING_PROVIDER="mock"

# OpenAI Embedding Model Configuration (required if EMBEDDING_PROVIDER="openai")
# OPENAI_API_KEY="sk-your-openai-api-key-placeholder"
EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_BASE_URL="https://api.openai.com/v1"

# ------------------------------------------------------------------------------
# 7. Transactional Email & Invitation Delivery (SERVER ONLY)
# ------------------------------------------------------------------------------
# Active provider: "gmail" (SMTP) | "resend" | "qa_capture" (In-memory test capture)
EMAIL_PROVIDER="gmail"
EMAIL_FROM="BrandShield AI <noreply@brandshield.ai>"

# Gmail / Custom SMTP Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-google-app-password"

# Resend API Settings (if EMAIL_PROVIDER="resend")
# RESEND_API_KEY="re_your_resend_api_key_placeholder"

# In-memory QA email capture (set to "true" during CI/CD test runs to suppress outbound SMTP)
QA_EMAIL_CAPTURE="false"
